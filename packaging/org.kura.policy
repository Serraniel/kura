<!-- Installed to /usr/share/polkit-1/actions/. auth_admin_keep: one password
     prompt covers the steps of one change. Keep the texts in sync with i18n/. -->
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>kura</vendor>
  <vendor_url>https://github.com/Serraniel/kura</vendor_url>
  <icon_name>system-software-install</icon_name>
  <action id="org.kura.update">
    <description>Install updates</description>
    <description xml:lang="de">Updates installieren</description>
    <description xml:lang="fr">Installer des mises à jour</description>
    <description xml:lang="ja">アップデートのインストール</description>
    <message>Authentication is required to install updates.</message>
    <message xml:lang="de">Zum Installieren von Updates ist eine Anmeldung erforderlich.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour installer des mises à jour.</message>
    <message xml:lang="ja">アップデートをインストールするには認証が必要です。</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.kura.install">
    <description>Install software</description>
    <description xml:lang="de">Software installieren</description>
    <description xml:lang="fr">Installer des logiciels</description>
    <description xml:lang="ja">ソフトウェアのインストール</description>
    <message>Authentication is required to install software.</message>
    <message xml:lang="de">Zum Installieren von Software ist eine Anmeldung erforderlich.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour installer des logiciels.</message>
    <message xml:lang="ja">ソフトウェアをインストールするには認証が必要です。</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.kura.remove">
    <description>Remove software</description>
    <description xml:lang="de">Software entfernen</description>
    <description xml:lang="fr">Supprimer des logiciels</description>
    <description xml:lang="ja">ソフトウェアの削除</description>
    <message>Authentication is required to remove software.</message>
    <message xml:lang="de">Zum Entfernen von Software ist eine Anmeldung erforderlich.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour supprimer des logiciels.</message>
    <message xml:lang="ja">ソフトウェアを削除するには認証が必要です。</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.kura.restore">
    <description>Go back to an earlier state</description>
    <description xml:lang="de">Zu einem früheren Stand zurückkehren</description>
    <description xml:lang="fr">Revenir à un état antérieur</description>
    <description xml:lang="ja">以前の状態に戻す</description>
    <message>Authentication is required to go back to an earlier state of the system.</message>
    <message xml:lang="de">Zum Zurückkehren zu einem früheren Systemstand ist eine Anmeldung erforderlich.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour revenir à un état antérieur du système.</message>
    <message xml:lang="ja">システムを以前の状態に戻すには認証が必要です。</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.kura.mirrors">
    <description>Choose download servers</description>
    <description xml:lang="de">Download-Server auswählen</description>
    <description xml:lang="fr">Choisir les serveurs de téléchargement</description>
    <description xml:lang="ja">ダウンロードサーバーの選択</description>
    <message>Authentication is required to change the download servers.</message>
    <message xml:lang="de">Zum Ändern der Download-Server ist eine Anmeldung erforderlich.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour changer les serveurs de téléchargement.</message>
    <message xml:lang="ja">ダウンロードサーバーを変更するには認証が必要です。</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.kura.snapshots">
    <description>Set up snapshots</description>
    <description xml:lang="de">Snapshots einrichten</description>
    <description xml:lang="fr">Configurer les instantanés</description>
    <description xml:lang="ja">スナップショットの設定</description>
    <message>Authentication is required to set up snapshots.</message>
    <message xml:lang="de">Zum Einrichten von Snapshots ist eine Anmeldung erforderlich.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour configurer les instantanés.</message>
    <message xml:lang="ja">スナップショットを設定するには認証が必要です。</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.kura.aur">
    <description>Build and install software from the AUR</description>
    <description xml:lang="de">Software aus dem AUR bauen und installieren</description>
    <description xml:lang="fr">Compiler et installer des logiciels de l'AUR</description>
    <description xml:lang="ja">AUR のソフトウェアをビルドしてインストール</description>
    <message>Authentication is required to build and install software from the AUR.</message>
    <message xml:lang="de">Zum Bauen und Installieren von Software aus dem AUR ist eine Anmeldung erforderlich.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour compiler et installer des logiciels de l'AUR.</message>
    <message xml:lang="ja">AUR のソフトウェアをビルドしてインストールするには認証が必要です。</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.kura.settings">
    <description>Change kura's settings for all users</description>
    <description xml:lang="de">Einstellungen von kura für alle Benutzer ändern</description>
    <description xml:lang="fr">Modifier les réglages de kura pour tous les utilisateurs</description>
    <description xml:lang="ja">すべてのユーザーの kura の設定を変更</description>
    <message>Authentication is required to change kura's settings.</message>
    <message xml:lang="de">Zum Ändern der Einstellungen von kura ist eine Anmeldung erforderlich.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour modifier les réglages de kura.</message>
    <message xml:lang="ja">kura の設定を変更するには認証が必要です。</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
